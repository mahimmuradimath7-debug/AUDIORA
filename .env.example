# Copy to .env and choose a long, unique creator token (at least 24 characters).
# No upload is permitted until you set this value. Never commit .env.
AUDIORA_ADMIN_TOKEN=
HOST=127.0.0.1
PORT=3000
# Maximum MP3 size in bytes (100 MiB).
MAX_UPLOAD_BYTES=104857600
# For TLS reverse-proxy deployment, set the exact public origin, without a slash.
# PUBLIC_ORIGIN=https://audiora.example.com
