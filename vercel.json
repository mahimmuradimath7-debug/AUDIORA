{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{frontend,media,backend,data}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/media/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
