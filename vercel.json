{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,media,backend,data}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/media/uploads/(.*)", "destination": "/api/index.js" }
  ]
}
